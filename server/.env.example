# SpendWise Backend Environment Variables Template

# Port (Render automatically assigns PORT)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Connection String (Atlas URI in production or local MongoDB)
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/spendwise?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/spendwise?retryWrites=true&w=majority

# JWT Secret (Generate a strong 32+ character random secret)
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# In production on Render, set to your Vercel deployment domain
CLIENT_URL=https://spendwise.vercel.app

# Web Push Notification VAPID Keys
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@spendwise.app
